    },
    {
      "id": "specs_specs_supabase_realtime",
      "label": "Supabase Realtime (postgres_changes)",
      "file_type": "concept",
      "rationale": "postgres_changes channel notifies Admin Dashboard of new orders and PAYMENT_SENT, and the diner page of order status changes.",
      "source_file": "/home/manuel/Documentos/pagamesa/specs/specs.md",
      "source_location": "§9",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "specs_specs_rls",
      "label": "Row-Level Security (RLS) Isolation",
      "file_type": "concept",
      "rationale": "Data isolation must be absolute; security delegated to the database engine, not the application layer. Warning: UPDATE silently affects 0 rows without explicit SELECT policy; helpers get_user_restaurant_id() and is_superadmin().",
      "source_file": "/home/manuel/Documentos/pagamesa/specs/specs.md",
      "source_location": "§3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "specs_specs_repository_pattern",
      "label": "Async Repository Pattern",
      "file_type": "rationale",
      "rationale": "ORM objects prohibited in the service layer to avoid 'Detached Instance' errors; repositories map results to Pydantic models before returning. Business logic consumes flat validated schemas.",
      "source_file": "/home/manuel/Documentos/pagamesa/specs/specs.md",
      "source_location": "§3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "specs_specs_schema",
      "label": "Database Schema (10 Tables)",
      "file_type": "concept",
      "rationale": "restaurants (tenant) + profiles, tables, menu_categories/menu_items, orders/order_items/order_status_history/payments, commissions ($0.10/order).",
      "source_file": "/home/manuel/Documentos/pagamesa/specs/specs.md",
      "source_location": "§3",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "specs_specs_order_state_machine",
      "label": "Order Status State Machine",
      "file_type": "concept",
      "rationale": "PENDING → PAYMENT_SENT → CONFIRMED → PREPARING → READY → DELIVERED, with CANCELLED reachable from any state; payment status PENDING → VERIFIED / REJECTED.",
      "source_file": "/home/manuel/Documentos/pagamesa/specs/specs.md",
      "source_location": "§5",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "specs_specs_commission_system",
      "label": "Commission System ($0.10 per Confirmed Order)",
      "file_type": "concept",
      "rationale": "Commission shown as 'Mantenimiento de la App' in the customer receipt; restaurant collects it from customer and superadmin collects manually; commission_count is not auto-updated yet.",
      "source_file": "/home/manuel/Documentos/pagamesa/specs/specs.md",
      "source_location": "§8",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "specs_specs_commission_service",
      "label": "CommissionService (backend)",
      "file_type": "code",
      "rationale": "record_commission(order_id, restaurant_id) creates commission row and increments restaurant.commission_count at CONFIRMED transition.",
      "source_file": "/home/manuel/Documentos/pagamesa/specs/specs.md",
      "source_location": "§8",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "specs_specs_anti_fraud",
      "label": "P2P Fraud Prevention (Unique Bank Reference)",
      "file_type": "rationale",
      "rationale": "Composite unique index (restaurant_id, bank_reference) blocks bank-reference reuse; audit trail via order_status_history.",
