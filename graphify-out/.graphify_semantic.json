      "id": "specs_specs_supabase_auth",
      "label": "Supabase Auth (Source of Truth)",
      "file_type": "concept",
      "rationale": "Supabase Auth handles token issuance, hashing and validation; get_supabase()/get_supabase_admin() client factories, create_auth_user(), get_user_by_token().",
