    {
      "id": "specs_specs_qr_ordering",
      "label": "QR Ordering with Table Identifiers",
      "file_type": "concept",
      "rative": "Dynamic QR codes with integrated table identifiers eliminate friction between diner and service, reducing operational latency from menu discovery to payment confirmation.",
      "source_file": "/home/manuel/Documentos/pagamesa/specs/specs.md",
      "source_location": "§1, §4",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "specs_specs_custom_jwt_auth",
      "label": "Legacy Custom JWT Auth (removed)",
      "file_type": "concept",
      "rationale": "python-jose + passlib custom JWT implementation removed; hashed_password field deprecated; Supabase Auth adopted as SSOT.",
      "source_file": "/home/manuel/Documentos/pagamesa/specs/specs.md",
      "source_location": "§6, §11",
