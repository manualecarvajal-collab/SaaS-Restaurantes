    {
      "id": "specs_specs_pago_movil",
      "label": "Pago Móvil (Venezuelan P2P Payments)",
      "file_type": "concept",
      "rationale": "Customer pays the restaurant's bank account; restaurant receives full amount; superadmin collects commissions manually/officially. Local rail decouples from international gateway trap.",
      "source_file": "/home/manuel/Documentos/pagamesa/specs/specs.md",
      "source_location": "§7",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "specs_specs_hitl",
      "label": "Human-in-the-Loop (HITL) Payment Validation",
      "file_type": "rationale",
      "rationale": "Technology optimizes flow but human control ensures final capital validation; adaptive to local payment rails and acts as the financial resilience axis.",
      "source_file": "/home/manuel/Documentos/pagamesa/specs/specs.md",
      "source_location": "§1, §7",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "specs_specs_financial_sovereignty",
      "label": "Financial Sovereignty / Gateway Decoupling",
      "file_type": "rationale",
      "rationale": "Decoupling from global payment processors avoids predatory fees and settlement delays; local P2P Mobile Payments deliver immediate cash availability and reduced transaction costs.",
      "source_file": "/home/manuel/Documentos/pagamesa/specs/specs.md",
      "source_location": "§1",
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
